# Copy to config/wsli.env (gitignored) — never commit tokens

WEALTHSIMPLE_ACCESS_TOKEN=
WEALTHSIMPLE_REFRESH_TOKEN=
WEALTHSIMPLE_OAUTH_JSON=
WEALTHSIMPLE_OAUTH_CLIENT_ID=

# Trade execution gates (set by hooks / user approval)
TRADE_APPROVED=false
PAUSE_ALL_TRADING=false

# Email notifications (Resend)
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=portfolio@yourdomain.com
